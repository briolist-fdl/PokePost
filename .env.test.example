# Use a separate test application and an empty, separate PostgreSQL database.
# Never put real values into the example file or commit .env.test.
POKEPOST_TEST_CLIENT_ID=
POKEPOST_TEST_TOKEN=
POKEPOST_TEST_GUILD_IDS=
POKEPOST_TEST_DATABASE_URL=

# Explicit opt-in for the closed test runtime; guild bump_enabled must also be true.
POKEPOST_TEST_ENABLE_BUMPS=false

# Group threads use existing per-server configuration; opt-in is separate from bumps.
POKEPOST_TEST_ENABLE_THREADS=false
